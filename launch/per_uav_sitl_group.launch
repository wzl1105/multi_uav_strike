<?xml version="1.0"?>
<!--
  per_uav_sitl_group.launch
  ============================================================
  单个 UAV 的完整 SITL 子树(SITL 仿真场景)
  ============================================================
  用途:多机 launch 文件 (multi_uav_px4_sitl_test_*.launch) 通过
       `<include file="per_uav_sitl_group.launch">` 调用本文件 N 次,
       每次传不同的 uav_name / fcu_url / tgt_system / flow / device_id,
       实现"per-UAV 配置独立 + UAV 共享 target_motion"。

  包含节点 (8 个):
    1. mavros                       (PX4 SITL <-> ROS 桥)
    2. gimbal_simulator_node        (云台仿真 + YOLO 模拟)
    3. target_estimator_node        (反投影 + 多实例聚类)
    4. guidance_control_node        (制导律)
    5. waypoint_executor_node       (航点执行 + 状态上报)
    6. comm_node                    (机间通信: 广播本机位姿 + 接收邻居)
    7. mission_manager_node         (TaskFlow 状态机)
    8. uav_avoidance_node           (机间避障决策)
    9. gs_simulator_node.py         (模拟地面站,发布 typed TaskFlow)

  使用方法:
    <include file="$(find multi_uav_strike)/launch/per_uav_sitl_group.launch">
      <arg name="uav_name"  value="uav0" />
      <arg name="fcu_url"   value="udp://:14540@127.0.0.1:14580" />
      <arg name="tgt_system" value="1" />
      <arg name="flow"      value="ground_search_track" />
      <arg name="device_id" value="0" />
    </include>

  默认值对齐单 UAV 的 single_uav_px4_sitl_test.launch,所以本文件单独
  运行(不放在 <group ns=...> 里)时表现与单机完全一致。
-->
<launch>
  <!-- 默认参数(单机版测试兼容) -->
  <arg name="uav_name"   default="uav0" />
  <arg name="fcu_url"    default="udp://:14540@127.0.0.1:14580" />
  <arg name="tgt_system" default="1" />
  <arg name="flow"       default="ground_search_track" />
  <arg name="device_id"  default="0" />
  <!-- UAV 硬件序列号(命名约定 "<group>-<plane>",如 "1-1"、"1-2"...) -->
  <!-- 空 → comm_node/uav_avoidance 回落到 uav_name (uav0/uav1/uav2),gs_simulator 同 -->
  <arg name="device_sn"  default="" />
  <!-- 多机集结伙伴名单(逗号分隔,如 "1-1,1-2,1-3")。空 = 单机路径 -->
  <arg name="gather_partners" default="" />
  <!-- RViz 世界参考点:单机 auto=true → world_ref=本机 home,永在原点。 -->
  <!-- 多机 launch 传 world_ref_auto=false + 共享 world_ref_lat/lon/alt,各机按 GPS 偏移分开。 -->
  <arg name="world_ref_auto" default="true" />
  <arg name="world_ref_lat"  default="36.058" />
  <arg name="world_ref_lon"  default="114.549" />
  <arg name="world_ref_alt"  default="75.0" />

  <!-- Set GeographicLib data path (PX4 GPS 转换需要) -->
  <env name="GEOGRAPHICLIB_DATA" value="$(env HOME)/.GeographicLib" />

  <!-- ====================================================================== -->
  <!-- 1. MAVROS + PX4 SITL                                                   -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url"    value="$(arg fcu_url)" />
      <arg name="tgt_system" value="$(arg tgt_system)" />
    </include>
  </group>

  <!-- ====================================================================== -->
  <!-- 2. 云台仿真节点                                                          -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="gimbal_simulator_node"
          pkg="multi_uav_strike"
          type="gimbal_simulator_node"
          output="screen"
          respawn="false">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/gimbal_simulator.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 3. 目标估计节点 (粒子滤波 / 像素反投影)                                  -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="target_estimator_node"
          pkg="multi_uav_strike"
          type="target_estimator_node"
          output="screen"
          respawn="false">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/target_estimator.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 4. 制导控制节点                                                          -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="guidance_control_node"
          pkg="multi_uav_strike"
          type="guidance_control_node"
          output="screen"
          respawn="false">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/guidance_control.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 5. 航点执行器节点                                                        -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="waypoint_executor_node"
          pkg="multi_uav_strike"
          type="waypoint_executor_node"
          output="screen"
          respawn="false">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/waypoint_executor.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 6. 通信节点 (机间共享: 发布本机位姿 / 接收邻居位姿 / 共享目标)            -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="comm_node"
          pkg="multi_uav_strike"
          type="comm_node"
          output="screen"
          respawn="false">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <param name="uav_name" value="$(arg uav_name)" />
      <param name="uav_device_sn" value="$(arg device_sn)" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 7. 任务管理器 (TaskFlow 状态机)                                          -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="mission_manager_node"
          pkg="multi_uav_strike"
          type="mission_manager_node"
          output="screen"
          respawn="false">
      <param name="device_id" value="$(arg device_id)" />
      <param name="uav_device_sn" value="$(arg device_sn)" />
      <param name="world_ref_auto" value="$(arg world_ref_auto)" />
      <param name="world_ref_lat"  value="$(arg world_ref_lat)" />
      <param name="world_ref_lon"  value="$(arg world_ref_lon)" />
      <param name="world_ref_alt"  value="$(arg world_ref_alt)" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/mission_manager.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 8. 机间避障决策节点 (基于优先级 + 横向严禁 + 高度 bias + 速度 scale)     -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="uav_avoidance_node"
          pkg="multi_uav_strike"
          type="uav_avoidance_node"
          output="screen"
          respawn="false">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/uav_avoidance.yaml" />
      <param name="uav_id" value="$(arg uav_name)" />
      <param name="uav_device_sn" value="$(arg device_sn)" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 9. 地面站模拟器 (typed TaskFlow 发布者, 模拟真实 GS 给本机派任务)         -->
  <!--    必须在全局命名空间,因为它读取 uav_ns 自己发 /<uav_ns>/mission/task_flow -->
  <!--    每个 UAV 一个实例,各自独立的 uav_ns + flow                            -->
  <!--    节点名带 uav_name 后缀以保证多机 include 时节点名不冲突                -->
  <!-- ====================================================================== -->
  <node name="gs_simulator_node_$(arg uav_name)"
        pkg="multi_uav_strike"
        type="gs_simulator_node.py"
        output="screen"
        respawn="false"
        launch-prefix="bash -c 'sleep 2; $@' --">
    <param name="flow"   value="$(arg flow)" />
    <param name="uav_ns" value="$(arg uav_name)" />
    <param name="gather_partners" value="$(arg gather_partners)" />
    <rosparam command="load"
              file="$(find multi_uav_strike)/config/common.yaml" />
  </node>

</launch>
