<?xml version="1.0"?>
<!--
  single_uav_px4_sitl_test.launch
  单机 PX4 SITL 测试 launch

  使用方法：
  1. 先启动 PX4 SITL: ./src/PX4_Firmware/Tools/sitl_dual_run.sh
  2. 再启动此 launch: roslaunch multi_uav_strike single_uav_px4_sitl_test.launch

  参数组织：
  - 跨节点共享参数：config/common.yaml（每个节点都加载一次）
  - 各节点专属参数：config/<node_name>.yaml（平铺结构，键名与 C++ 完全一致）
  - 命令行可覆盖参数：本文件顶部 <arg>

  加载机制：
  <rosparam command="load" file="..." /> 在 <node> 内部时，参数会被加载到该节点的
  私有命名空间（/<ns>/<node_name>/），正好是 nh_private_.param 的查找路径。
  关键：YAML 必须是平铺结构，不能有嵌套 group，否则会出现双层前缀
  （如 <rosparam ns="gimbal" /> 加上 YAML 里的 gimbal: 嵌套，会变成
   /<ns>/<node>/gimbal/gimbal/<key>，C++ 找不到）。
-->
<launch>
  <!-- ====================================================================== -->
  <!-- 命令行可覆盖参数                                                         -->
  <!-- ====================================================================== -->
  <!-- 默认 IDLE：飞机在地面等待，不会自动起飞。
       flow 选定后由 gs_simulator_node.py 发布 typed TaskFlow 到 /<ns>/mission/task_flow,
       mission_manager 根据首发 skill 自动切 work_mode。
       可选 flow:
         - ground_search_strike  (地面起飞 + 搜索 + 打击)
         - ground_search_track   (地面起飞 + 搜索跟踪)
         - ground_gather_search  (地面起飞 + 集结 + 搜索)
         - catapult_search_return(弹射起飞 + 搜索 + 返航)
  -->
  <arg name="uav_name" default="uav0" />
  <arg name="flow" default="" />

  <!-- Set GeographicLib data path -->
  <!-- <env name="GEOGRAPHICLIB_DATA" value="$(env HOME)/.GeographicLib" /> -->

  <!-- ====================================================================== -->
  <!-- 1. MAVROS + PX4 SITL                                                  -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="serial:///dev/ttyS1:921600" />
      <!--arg name="fcu_url" value="/dev/ttyS1:57600" /-->
      <arg name="tgt_system" value="$(optenv TZS_FCU_ID 1)" />
      <!--arg name="gcs_ip" value="192.168.1.2"/>
	  <arg name="gcs_port" value="14550"/-->
      <!--arg name="gcs_url" value="udp://:14551@192.168.1.10:14550"/-->
      <arg name="gcs_url" value="udp://:14551@192.168.1.10:14550"/>
    </include>
    <rosparam param="/uav0/mavros/plugin_blacklist">[]</rosparam>
    <rosparam param="/uav0/mavros/plugin_whitelist">['sys_status', 'sys_time', 'global_position', 'local_position', 'setpoint_position', 'setpoint_velocity', 'setpoint_raw', 'setpoint_trajectory', 'setpoint_attitude', 'home_position', 'imu', 'param', 'waypoint', 'command', 'gps_status']</rosparam>
  </group>

  <!-- ====================================================================== -->
  <!-- 2. 目标运动模拟（仿真目标车辆）                                          -->
  <!-- ====================================================================== -->
  <node name="target_motion_simulator_node"
        pkg="multi_uav_strike"
        type="target_motion_simulator_node"
        output="screen"
        respawn="true">
    <rosparam command="load"
              file="$(find multi_uav_strike)/config/target_motion_simulator.yaml" />
  </node>

  <!-- ====================================================================== -->
  <!-- 3. 云台模拟节点                                                          -->
  <!-- ====================================================================== -->
  <!-- <group ns="$(arg uav_name)">
    <node name="gimbal_simulator_node"
          pkg="multi_uav_strike"
          type="gimbal_simulator_node"
          output="screen"
          respawn="true">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/gimbal_simulator.yaml" />
    </node>
  </group> -->

  <!-- ====================================================================== -->
  <!-- 4. 目标估计节点（粒子滤波）                                              -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="target_estimator_node"
          pkg="multi_uav_strike"
          type="target_estimator_node"
          output="screen"
          respawn="true">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/target_estimator.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 5. 制导控制节点                                                          -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="guidance_control_node"
          pkg="multi_uav_strike"
          type="guidance_control_node"
          output="screen"
          respawn="true">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/guidance_control.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 6. 航点执行器节点                                                        -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="waypoint_executor_node"
          pkg="multi_uav_strike"
          type="waypoint_executor_node"
          output="screen"
          respawn="true">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/waypoint_executor.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 7. 通信节点                                                              -->
  <!-- ====================================================================== -->
  <!-- <group ns="$(arg uav_name)">
    <node name="comm_node"
          pkg="multi_uav_strike"
          type="comm_node"
          output="screen"
          respawn="true">
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <param name="uav_name" value="$(arg uav_name)" />
    </node>
  </group> -->

  <!-- ====================================================================== -->
  <!-- 8. 任务管理器节点                                                        -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="mission_manager_node"
          pkg="multi_uav_strike"
          type="mission_manager_node"
          output="screen"
          respawn="true">
      <param name="device_id" value="0" />
      <param name="uav_device_sn" value="$(optenv TZS_DEVICE_SN 1-1)" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/mission_manager.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 8b. 机间避障决策节点(基于优先级,横向严禁 + 高度 bias + 速度 scale)        -->
  <!--    注: 检测功能已合并到 gimbal_simulator_node(FOV 由当前云台角度决定)   -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node name="uav_avoidance_node"
          pkg="multi_uav_strike"
          type="uav_avoidance_node"
          output="screen"
          respawn="true">
      <param name="uav_device_sn" value="$(optenv TZS_DEVICE_SN 1-1)" />
      <param name="uav_id" value="$(optenv TZS_DEVICE_SN 1-1)" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/common.yaml" />
      <rosparam command="load"
                file="$(find multi_uav_strike)/config/uav_avoidance.yaml" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 9. 地面站模拟器（仿真测试用）                                            -->
  <!-- ====================================================================== -->
   
  <group ns="$(arg uav_name)">
    <node pkg="starling_bridge" type="starling_bridge" name="starling_bridge" respawn="true" output="screen">
      <!-- 地面站 IP 和端口 -->
      <param name="gcs_ip" value="192.168.1.1" />
      <param name="gcs_udp_port" value="14550" />
      <param name="gcs_kcp_port" value="18990" />
      <param name="device_name" value="$(optenv TZS_DEVICE_SN 1-0)" />
      <param name="device_sn" value="$(optenv TZS_DEVICE_SN 1-0)" />
      <param name="system_id" value="$(optenv TZS_FCU_ID 1)" />

      <!-- 机间 UDP 广播心跳(替代 multi_uav_strike/comm_node 对外广播);
           实机跨主机时各台用 TZS_DEVICE_SN=1-1/1-2/1-3 区分。
           inter_uav_broadcast_ip 空 → 自动按 gcs_ip 同子网算 directed broadcast。 -->
      <param name="inter_uav_broadcast_ip" value="" />
      <param name="inter_uav_broadcast_port" value="19590" />
      <param name="heartbeat_base_rate"   value="1.0" />
      <param name="heartbeat_near_rate"   value="5.0" />
      <param name="heartbeat_close_rate"  value="20.0" />
      <param name="heartbeat_near_thresh" value="40.0" />
      <param name="heartbeat_close_thresh" value="20.0" />
      <param name="neighbor_timeout"      value="5.0" />
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 10. 电源信息板通信节点                                                          -->
  <!-- ====================================================================== -->
  <group ns="$(arg uav_name)">
    <node pkg="multi_uav_strike" type="power_interact_node" name="power_interact_node" respawn="true" output="screen">
    </node>
  </group>

  <!-- ====================================================================== -->
  <!-- 11. RViz 可视化                                                          -->
  <!-- ====================================================================== -->
  <!-- <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find multi_uav_strike)/rviz/view_strike_SITL.rviz" /> -->

  <!-- ====================================================================== -->
  <!-- 12. ROSBag 自动记录                                                      -->
  <!-- ====================================================================== -->
  <arg name="record_bag" default="true"/>
  <arg name="bag_dir" default="/home/rpdzkj/tzs_ws/LOG"/>
  <arg name="bag_prefix" default="multi_uav_flight"/>

  <group if="$(arg record_bag)">
  <node pkg="rosbag"
        type="record"
        name="flight_rosbag_record"
        output="screen"
        required="false"
        args="-a
              --split
              --size=2048
              --buffsize=1024
              -x '.*(/ros_short_image$|/ros_ir_image$|/ros_long_image$|/ros_vis_image_res$|/ros_ir_image_res$|/ros_zoom_image$).*'
              -o $(arg bag_dir)/$(arg bag_prefix)"/>
  </group>

</launch>
