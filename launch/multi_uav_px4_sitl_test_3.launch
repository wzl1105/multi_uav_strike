<?xml version="1.0"?>
<!--
  multi_uav_px4_sitl_test_3.launch
  ============================================================
  三机 PX4 SITL 测试 launch
  ============================================================
  启动 3 架仿真 UAV,各自独立 PX4 SITL 实例 + 独立任务流,
  共享 target_motion_simulator_node (所有 UAV 看到同一组仿真目标)。

  使用方法:
    1. 先启动 3 个 PX4 SITL 实例 (sitl_multiple_run.sh 3):
       PX4_SIM_MODEL=iris PX4_HOME_LAT=... PX4_HOME_ALT=75 \
         ./Tools/jmavsim_run.sh -l &        # 实例 1 (端口 14580)
       PX4_SIM_MODEL=iris PX4_HOME_LAT=... PX4_HOME_ALT=75 \
         ./Tools/jmavsim_run.sh -p 4561 -l & # 实例 2 (端口 14581)
       PX4_SIM_MODEL=iris PX4_HOME_LAT=... PX4_HOME_ALT=75 \
         ./Tools/jmavsim_run.sh -p 4562 -l & # 实例 3 (端口 14582)
       (具体端口取决于 PX4 配置,sitl_dual_run.sh 已经验证 14580/14581)
    2. 再启动本 launch:
       roslaunch multi_uav_strike multi_uav_px4_sitl_test_3.launch

  端口分配:
    uav0: udp://:14540@127.0.0.1:14580  tgt_system=1
    uav1: udp://:14541@127.0.0.1:14581  tgt_system=2
    uav2: udp://:14542@127.0.0.1:14582  tgt_system=3

  任务流 (各自独立, 默认同流程):
    uav0/1/2: ground_search_track
-->
<launch>
  <!-- 命令行可覆盖: 每个 UAV 独立 flow -->
  <arg name="uav0_flow" default="multi_uav0_search" />
  <arg name="uav1_flow" default="multi_uav1_search" />
  <arg name="uav2_flow" default="multi_uav2_search" />
  <!-- <arg name="uav0_flow" default="avoid_test_uav0" />
  <arg name="uav1_flow" default="avoid_test_uav1" />
  <arg name="uav2_flow" default="avoid_test_uav2" /> -->

  <!-- 共享世界参考点(应 = uav0 的 PX4_HOME GPS):多机 RViz 分离靠 static TF map-><ns>/map。 -->
  <!-- world_ref_auto=false → 各机据此共享参考点算偏移;uav0=identity 在原点。 -->
  <!-- 若改了 uav0 的 PX4_HOME_LAT/LON,这里要同步改,否则 uav0 不在原点。 -->
  <!-- world_ref_alt 不参与 TF(平移 z 固定 0),仅占位。 -->
  <arg name="world_ref_lat" default="36.05801135" />
  <arg name="world_ref_lon" default="114.5491114" />
  <arg name="world_ref_alt" default="0.0" />
  <!--根据实际系统路径修改 -->
  <env name="GEOGRAPHICLIB_DATA" value="/usr/share/GeographicLib" />

  <!-- 共享节点:目标运动模拟 -->
  <node name="target_motion_simulator_node"
        pkg="multi_uav_strike"
        type="target_motion_simulator_node"
        output="screen"
        respawn="false">
    <rosparam command="load"
              file="$(find multi_uav_strike)/config/target_motion_simulator.yaml" />
  </node>

  <!-- UAV0 -->
  <include file="$(find multi_uav_strike)/launch/per_uav_sitl_group.launch">
    <arg name="uav_name"   value="uav0" />
    <arg name="fcu_url"    value="udp://:14540@127.0.0.1:14580" />
    <arg name="tgt_system" value="1" />
    <arg name="flow"       value="$(arg uav0_flow)" />
    <arg name="device_id"  value="0" />
    <arg name="device_sn"  value="1-1" />
    <arg name="gather_partners" value="1-1,1-2,1-3" />
    <arg name="world_ref_auto" value="false" />
    <arg name="world_ref_lat"  value="$(arg world_ref_lat)" />
    <arg name="world_ref_lon"  value="$(arg world_ref_lon)" />
    <arg name="world_ref_alt"  value="$(arg world_ref_alt)" />
  </include>

  <!-- UAV1 -->
  <include file="$(find multi_uav_strike)/launch/per_uav_sitl_group.launch">
    <arg name="uav_name"   value="uav1" />
    <arg name="fcu_url"    value="udp://:14541@127.0.0.1:14581" />
    <arg name="tgt_system" value="2" />
    <arg name="flow"       value="$(arg uav1_flow)" />
    <arg name="device_id"  value="1" />
    <arg name="device_sn"  value="1-2" />
    <arg name="gather_partners" value="1-1,1-2,1-3" />
    <arg name="world_ref_auto" value="false" />
    <arg name="world_ref_lat"  value="$(arg world_ref_lat)" />
    <arg name="world_ref_lon"  value="$(arg world_ref_lon)" />
    <arg name="world_ref_alt"  value="$(arg world_ref_alt)" />
  </include>

  <!-- UAV2 -->
  <include file="$(find multi_uav_strike)/launch/per_uav_sitl_group.launch">
    <arg name="uav_name"   value="uav2" />
    <arg name="fcu_url"    value="udp://:14542@127.0.0.1:14582" />
    <arg name="tgt_system" value="3" />
    <arg name="flow"       value="$(arg uav2_flow)" />
    <arg name="device_id"  value="2" />
    <arg name="device_sn"  value="1-3" />
    <arg name="gather_partners" value="1-1,1-2,1-3" />
    <arg name="world_ref_auto" value="false" />
    <arg name="world_ref_lat"  value="$(arg world_ref_lat)" />
    <arg name="world_ref_lon"  value="$(arg world_ref_lon)" />
    <arg name="world_ref_alt"  value="$(arg world_ref_alt)" />
  </include>

  <!-- RViz 三机版 -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find multi_uav_strike)/rviz/view_strike_triple.rviz" />

</launch>
